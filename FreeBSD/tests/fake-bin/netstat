#!/bin/sh
# Fake netstat(1) for the smoke test: a default route out of wlan0.

case "$*" in
    "-rn -f inet")
        echo 'Routing tables'
        echo ''
        echo 'Internet:'
        echo 'Destination        Gateway            Flags     Netif Expire'
        echo 'default            192.0.2.1          UGS       wlan0'
        echo '127.0.0.1          link#1             UH          lo0'
        echo '192.0.2.0/24       link#2             U         wlan0'
        ;;
    *)
        echo "Unexpected fake netstat call: $*" >&2
        exit 1
        ;;
esac
